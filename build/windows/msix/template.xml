<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="auto-updater"
        Arguments=""
        InstallLocation="C:\Program Files\TwitchCaptain\Captain Updater">
    </Installer>
    <PackageInformation
        PackageName="Captain Updater"
        PackageDisplayName="Captain Updater"
        PublisherName="CN=TwitchCaptain"
        PublisherDisplayName="TwitchCaptain"
        Version="0.1.0.0"
        PackageDescription="Keep Windows apps current from GitHub releases">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.twitchcaptain.updater"
                Description="Keep Windows apps current from GitHub releases"
                DisplayName="Captain Updater"
                ExecutableName="auto-updater"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Captain Updater</DisplayName>
            <PublisherDisplayName>TwitchCaptain</PublisherDisplayName>
            <Description>Keep Windows apps current from GitHub releases</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="auto-updater.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
